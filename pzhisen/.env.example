# Auth
JWT_SECRET=
SESSION_SECRET=
OTP_EXPIRY_MINUTES=10
OTP_DEV_EXPOSE=false

# Email OTP + order notifications (SMTP)
# QQ 邮箱（几个月前的工作配置）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=768204575@qq.com
SMTP_PASS=
SMTP_FROM=768204575@qq.com
OTP_SMTP_USER=768204575@qq.com
OTP_SMTP_PASS=
OTP_SMTP_HOST=smtp.qq.com

# Merchant inbox for every global subscription order
ORDER_NOTIFY_EMAIL=LeeDh994@gmail.com

# Render free tier: outbound SMTP is blocked — use GitHub Actions bridge instead.
# Create a PAT with "Actions: Read and write" on this repo.
GITHUB_NOTIFY_TOKEN=
GITHUB_NOTIFY_REPO=leedh994-a11y/leedh994-a11y.github.io

NODE_ENV=production
PUBLIC_URL=https://www.pzhisen.online

OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://www.pzhisen.online
# OpenRouter vision model for image chat (optional)
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
DATA_DIR=./data

# PayPal (international)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Display email for settlement dashboard (masked in UI). Must match the PayPal account that owns CLIENT_ID.
PAYPAL_MERCHANT_EMAIL=
# Comma-separated merchant emails allowed to view real revenue dashboard
MERCHANT_OWNER_EMAILS=

# China bank transfer — 中国银行借记卡 (primary)
BANK_ACCOUNT_NAME=
BANK_NAME=中国银行
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_LABEL=中国银行借记卡

# Visa 借记卡 — same card as BOC (dual brand) OR fill BANK_VISA_* separately
BANK_VISA_SAME_AS_PRIMARY=true
BANK_VISA_LABEL=Visa 借记卡（同中国银行卡）
# BANK_VISA_ACCOUNT_NAME=
# BANK_VISA_NAME=
# BANK_VISA_ACCOUNT_NUMBER=
# BANK_VISA_BRANCH=

BILLING_ADMIN_SECRET=

# Comma-separated emails with permanent lifetime access (optional, in addition to built-in restores)
LIFETIME_EMAILS=
