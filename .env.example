# Sitp GPT (yoursite.asia) — environment variables

# Public site URL
PUBLIC_URL=https://yoursite.asia

# PayPal (production keys for global checkout)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# Order notification — merchant inbox (default: ddb1520@outlook.com)
ORDER_NOTIFY_EMAIL=ddb1520@outlook.com

# Option A: Direct SMTP (Outlook example)
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=ddb1520@outlook.com
# SMTP_PASS=your-app-password

# Option B: GitHub Actions email bridge (recommended if VPS blocks SMTP)
# Create a GitHub fine-grained PAT with "Contents: Read" + "Actions: Write"
GITHUB_NOTIFY_TOKEN=
GITHUB_NOTIFY_REPO=leedh994-a11y/leedh994-a11y.github.io

# Admin key for /api/billing/admin/notify-test
BILLING_ADMIN_SECRET=change-me

# Server
PORT=3000
DATA_DIR=./server/data
